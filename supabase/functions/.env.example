# Copy to supabase/functions/.env (git-ignored) for local runs, and set the
# same values in production with:  supabase secrets set --env-file supabase/functions/.env
#
# Everything here is a server secret or server setting. None of it ever ships
# inside the app.

# ── Claude ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxx
CLAUDE_MODEL=claude-opus-5-5
# Used automatically when the main model is overloaded or down. Empty = off.
CLAUDE_FALLBACK_MODEL=claude-sonnet-5-5
# Optional last resort if Anthropic is unreachable. Paid tier only, and add
# Google to the privacy policy's processor list before setting it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
# Hard stop for AI spend per UTC day (USD). New scans/chats get a polite
# "busy" message until midnight once it's reached.
DAILY_SPEND_LIMIT_USD=25

# ── Subscriptions (RevenueCat secret key, never the public one) ───────
REVENUECAT_SECRET_KEY=sk_xxx
REVENUECAT_ENTITLEMENT=premium

# ── Quotas ────────────────────────────────────────────────────────────
FREE_SCANS_PER_WINDOW=2
FREE_SCAN_WINDOW_DAYS=30
REWARDED_SCANS_PER_DAY=1
PREMIUM_DAILY_SCANS=5
PREMIUM_DAILY_COACH_MESSAGES=60
# Attempts per account or device in 24 h, refunded ones included. Stops
# scripts sending junk photos (refunded, so otherwise free) to burn AI spend.
SCAN_ATTEMPTS_PER_DAY=10
COACH_ATTEMPTS_PER_DAY=80

# ── Play Integrity (anti-tamper) ──────────────────────────────────────
# off | log | enforce. Keep "log" while testers use sideloaded APKs; switch
# to "enforce" for the production launch.
INTEGRITY_MODE=log
ANDROID_PACKAGE=com.clearskinai.app
# Service account with the Play Integrity API enabled, JSON or base64(JSON).
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── Affiliate shop links (served to the app by account-status) ────────
# Per country code (or "default"): store name and a search URL with {q}.
SHOP_CONFIG_JSON={"default":{"store":"Amazon","url":"https://www.amazon.com/s?k={q}&tag=YOURTAG-20"},"GB":{"store":"Amazon UK","url":"https://www.amazon.co.uk/s?k={q}&tag=YOURTAG-21"}}
